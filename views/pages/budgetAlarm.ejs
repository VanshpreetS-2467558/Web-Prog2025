<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" sizes="32x32">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Budget Alarm - FestCoin</title>
</head>
<body>
    <%- include("../partials/index/header") %>
    
    <main class="py-16">
        <section class="container mx-auto py-10 max-w-4xl">
            <!-- Header -->
            <div class="mb-8 bg-gradient-to-br from-blue-500/10 to-blue-500/5 border rounded-2xl p-6 shadow-sm">
                <div class="mb-4">
                    <h2 class="flex items-center gap-2 text-2xl font-extrabold bg-gradientkleurSmallText bg-clip-text text-transparent">
                        Budget Alarm Beheer
                    </h2>
                    <p class="text-gray-600 mt-2">Stel budget limieten in per categorie en ontvang notificaties wanneer je je budget overschrijdt.</p>
                </div>
            </div>

            <!-- Add New Alarm Form -->
            <div class="mb-8 bg-white border rounded-2xl p-6 shadow-sm">
                <h3 class="text-xl font-bold mb-4 text-gray-800">Nieuw Budget Alarm</h3>
                <form id="addAlarmForm" class="space-y-4">
                    <div>
                        <label for="alarmCategory" class="block text-sm font-medium text-gray-700 mb-2">Categorie</label>
                        <select id="alarmCategory" name="category" required class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                            <option value="" disabled selected>Selecteer een categorie</option>
                            <option value="Drank">Drank</option>
                            <option value="Eten">Eten</option>
                            <option value="Others">Others</option>
                        </select>
                    </div>
                    <div>
                        <label for="alarmBudgetLimit" class="block text-sm font-medium text-gray-700 mb-2">Budget Limiet (FestCoins)</label>
                        <input type="number" id="alarmBudgetLimit" name="budgetLimit" min="0" step="1" required 
                               class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                               placeholder="Bijv. 500">
                    </div>
                    <button type="submit" class="w-full bg-purple-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-600 transition-colors">
                        Alarm Toevoegen
                    </button>
                </form>
            </div>

            <!-- Active Alarms List -->
            <div class="bg-white border rounded-2xl p-6 shadow-sm">
                <h3 class="text-xl font-bold mb-4 text-gray-800">Mijn Budget Alarms</h3>
                <div id="alarmsList" class="space-y-4">
                    <% if (alarms && alarms.length > 0) { %>
                        <% alarms.forEach(alarm => { %>
                            <div class="alarm-card border rounded-lg p-4 hover:shadow-md transition-shadow" data-alarm-id="<%= alarm.id %>">
                                <div class="flex items-center justify-between">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-2">
                                            <h4 class="text-lg font-semibold text-gray-800"><%= alarm.category %></h4>
                                            <span class="px-3 py-1 rounded-full text-xs font-semibold <%= alarm.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
                                                <%= alarm.isActive ? 'Actief' : 'Inactief' %>
                                            </span>
                                        </div>
                                        <div class="space-y-1">
                                            <p class="text-sm text-gray-600">
                                                Budget: <span class="font-semibold text-gray-800"><%= alarm.budgetLimit %> FestCoins</span>
                                            </p>
                                            <p class="text-sm text-gray-600">
                                                Huidige uitgaven: <span class="font-semibold <%= alarm.currentSpending > alarm.budgetLimit ? 'text-red-600' : 'text-gray-800' %>">
                                                    <%= alarm.currentSpending %> FestCoins
                                                </span>
                                            </p>
                                            <% const percentage = Math.min(100, (alarm.currentSpending / alarm.budgetLimit) * 100); %>
                                            <div class="mt-2">
                                                <div class="w-full bg-gray-200 rounded-full h-2">
                                                    <div class="bg-purple-500 h-2 rounded-full transition-all duration-300" 
                                                         style="width: <%= percentage %>%"></div>
                                                </div>
                                                <p class="text-xs text-gray-500 mt-1"><%= Math.round(percentage) %>% van budget gebruikt</p>
                                            </div>
                                            <% if (alarm.currentSpending > alarm.budgetLimit) { %>
                                                <p class="text-sm font-semibold text-red-600 mt-2">
                                                    ⚠️ Budget overschreden met <%= alarm.currentSpending - alarm.budgetLimit %> FestCoins
                                                </p>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-2 ml-4">
                                        <button onclick="toggleAlarm(<%= alarm.id %>)" 
                                                class="px-4 py-2 rounded-lg text-sm font-semibold transition-colors <%= alarm.isActive ? 'bg-yellow-100 text-yellow-800 hover:bg-yellow-200' : 'bg-green-100 text-green-800 hover:bg-green-200' %>">
                                            <%= alarm.isActive ? 'Deactiveren' : 'Activeren' %>
                                        </button>
                                        <button onclick="editAlarm(<%= alarm.id %>, '<%= alarm.category %>', <%= alarm.budgetLimit %>)" 
                                                class="px-4 py-2 bg-blue-100 text-blue-800 rounded-lg text-sm font-semibold hover:bg-blue-200 transition-colors">
                                            Bewerken
                                        </button>
                                        <button onclick="deleteAlarm(<%= alarm.id %>)" 
                                                class="px-4 py-2 bg-red-100 text-red-800 rounded-lg text-sm font-semibold hover:bg-red-200 transition-colors">
                                            Verwijderen
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center py-8 text-gray-500">
                            <p class="text-lg">Nog geen budget alarms ingesteld.</p>
                            <p class="text-sm mt-2">Voeg hierboven een alarm toe om te beginnen!</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <!-- Edit Modal -->
    <div id="editModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full mx-4 shadow-xl">
            <h3 class="text-xl font-bold mb-4 text-gray-800">Budget Alarm Bewerken</h3>
            <form id="editAlarmForm" class="space-y-4">
                <input type="hidden" id="editAlarmId" name="alarmId">
                <div>
                    <label for="editAlarmCategory" class="block text-sm font-medium text-gray-700 mb-2">Categorie</label>
                    <select id="editAlarmCategory" name="category" required class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-purple-500 focus:border-purple-500" disabled>
                        <option value="Drank">Drank</option>
                        <option value="Eten">Eten</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
                <div>
                    <label for="editAlarmBudgetLimit" class="block text-sm font-medium text-gray-700 mb-2">Budget Limiet (FestCoins)</label>
                    <input type="number" id="editAlarmBudgetLimit" name="budgetLimit" min="0" step="1" required 
                           class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                           placeholder="Bijv. 500">
                </div>
                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-purple-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-600 transition-colors">
                        Opslaan
                    </button>
                    <button type="button" onclick="closeEditModal()" class="flex-1 bg-gray-200 text-gray-800 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition-colors">
                        Annuleren
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include("../partials/index/footer") %>
    <script type="module" src="/js/budgetAlarmScripts.js"></script>
</body>
</html>

