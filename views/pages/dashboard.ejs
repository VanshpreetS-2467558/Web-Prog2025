<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" sizes="32x32">
    <title>Dashboard - FestCoin</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <!-- Header -->
    <%- include("../partials/index/header") %>
    <!-- body -->
    <main class="pt-16">
        <%- include("../partials/dashboard/dashboardMain") %>
    </main>
    <!-- footer -->
    <%- include("../partials/index/footer") %>
    

    <% if(user.role === "organisator") { %>
        <script type="module" src="/js/dashboardOrg.js"></script>
    <% } else if(user.role === "bezoeker") { %>
        <script type="module" src="/js/dashboardUser.js"></script>
    <% } else if(user.role === "employee") {%>
        <script type="module" src="/js/dashboardEmployee.js"></script>
    <% } %>
    <script type="module" src="/js/transactions.js"></script>

</body>
</html>