<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" sizes="32x32">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Bestelgeschiedenis - FestCoin</title>
</head>
<body>
    <%- include("../partials/index/header") %>
    
    <main class="py-16">
        <section class="container mx-auto px-4 max-w-6xl">
            <%- include("../partials/orders/header") %>

            <% if (!transactions || transactions.length === 0) { %>
                <%- include("../partials/orders/emptyState") %>
            <% } else { %>
                <div class="space-y-6">
                    <% transactions.forEach(transaction => { %>
                        <%- include("../partials/orders/transactionCard", { transaction }) %>
                    <% }); %>
                </div>
            <% } %>
        </section>
    </main>

    <%- include("../partials/index/footer") %>
</body>
</html>

