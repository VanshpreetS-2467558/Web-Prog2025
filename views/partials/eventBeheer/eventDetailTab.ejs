<!-- DETAIL VIEW -->
<div class="container mx-auto p-10 min-h-screen hidden" id="eventDetailView">
  <div class="mt-10">
    <button onclick="closeEventDetail()" 
            class="mb-6 px-4 py-2 bg-blue-600 rounded-lg text-white font-semibold hover:bg-blue-700">
      ← Terug
    </button>

    <p id="errorMsgGeneral" class="font-thin text-red-600"></p>
    <% events.forEach(event => { %>
      

      <div class="eventDetailContent hidden" id="eventDetail-<%= event.id %>">
        <div class="border-2 border-purple-600 rounded-2xl p-4 mb-4">
          <div class="flex justify-between">
            <h1 class="text-4xl font-bold mb-2"><%= event.name %></h1>
            <div>
              <button class="bg-purple-500 text-white font-semibold px-3 py-1 rounded-lg hover:bg-purple-700"        
                      onclick="openAddEditModel('<%= event.id %>')">
                Event Info Bewerken
              </button>
            </div>
          </div>
          <p class="text-gray-500 mb-4"><%= event.location %></p>
          <p class="text-sm text-gray-400 mb-4">
            <%= new Date(event.startDate).toLocaleString("nl-BE") %> → <%= new Date(event.endDate).toLocaleString("nl-BE") %>
          </p>
          <% if(event.description) { %>
            <p class="mb-10"><%= event.description %></p>
          <% } %>
        </div>
        <div class="border-2 border-purple-600 rounded-2xl p-4 mb-4">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-semibold">Locaties & Items</h3>
            <button class="bg-purple-500 text-white px-3 py-1 rounded-lg hover:bg-purple-700"
                    onclick="openAddLocationModel('<%= event.id %>')">
              Locatie Toevoegen
            </button>
          </div>

          <% if(!event.stations || event.stations.length === 0) { %>
            <p class="text-gray-500 text-sm mb-6">Nog geen locaties toegevoegd</p>
          <% } else { %>
            <p id="errorMsgStation-<%= event.id %>" class="font-thin text-red-600"></p>
            <div class="grid gap-4">
              <% event.stations.forEach(st => { %>
                <div id="station-<%= st.id %>" class="border border-purple-500 rounded-xl p-4">
                  <div class="flex justify-between items-center">
                    <h4 class="font-semibold"><%= st.name %></h4>
                    <button class="bg-purple-500 px-2 py-1 rounded-lg text-sm text-white hover:bg-gray-300"
                            onclick="openAddItemModel('<%= st.id %>' ,'<%= event.id %>' )">
                      + Item
                    </button>
                  </div>
                  <p id="errorMsgItem-<%= event.id %>" class="font-thin text-red-600 mb-2"></p>
                  <% if(!st.items || st.items.length === 0) { %>
                    <p class="text-gray-500 text-sm">Nog geen items</p>
                  <% } else { %>
                    <div class="grid gap-2">
                      <% st.items.forEach(it => { %>
                        <div id="item-<%= it.id %>" class="flex justify-between items-center p-3 bg-pink-100 rounded-lg">
                          <div>
                            <p class="font-bold text-lg"><%= it.name %></p>
                            <p class="font-semibold text-base"><%= it.price %> FestCoins</p>
                            <p class="text-sm text-gray-500">Voorraad: <%= it.stock %></p>
                            <p class="text-sm text-gray-500">Categorie: <%= it.category %></p>
                          </div>
                          <button class="px-1 py-1" onclick="deleteItem('<%= it.id %>', '<%= event.id %>')">
                            <img src="/assets/icons/delete.png" alt="Delete" class="w-6 h-6">
                          </button>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                  <button class="bg-red-600 text-white px-2 py-1 rounded-lg hover:bg-red-700 mt-10" onclick="deleteStation('<%= st.id %>', '<%= event.id %>')">Locatie verwijderen</button>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
        <button class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 mt-6" onclick="deleteEvent('<%= event.id %>')">Evenement verwijderen</button>
      </div>
    <% }) %>
  </div>
</div>