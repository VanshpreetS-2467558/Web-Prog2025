<%- include("locatieAddForm") %>
<%- include("eventMakenForm") %>
<%- include("itemAddForm") %>
<%- include("eventInfoEditForm") %>
<%- include("eventDetailTab") %>

<div class="container mx-auto p-10 min-h-screen">

  <!-- LIST VIEW -->
  <div id="eventListView">
    <% if (!events || events.length === 0) { %>
      
      <div class="flex flex-col items-center justify-start pt-20 min-h-screen gap-6">
        <h2 class="p-3 text-6xl font-extrabold bg-gradientkleurBR bg-clip-text text-transparent">Maak je eerste evenement aan</h2>

        <button class="px-8 py-3 text-lg font-semibold rounded-full text-pink-500 border-2 border-pink-500 hover:bg-pink-500 hover:text-white transition-colors duration-300" 
                onclick="document.getElementById('EventAanmaakTab').classList.remove('hidden')">
          Start hier!
        </button>
      </div>

    <% } else { %>

      <!-- Header + knop -->
      <div class="flex justify-between">
        <h2 class="text-3xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">Evenementen:</h2>
        <button 
          class="bg-purple-500 text-white px-4 py-2 rounded-lg hover:bg-purple-600"
          onclick="document.getElementById('EventAanmaakTab').classList.remove('hidden')">
          Nieuw Evenement
        </button>
      </div>
      <p id="errorMsgDelete" class="font-thin text-red-600 mb-6"></p>

      <div class="space-y-6">

        <% events.forEach(event => { %>

          <div 
            class="border rounded-2xl p-6 shadow-sm hover:bg-gray-50 cursor-pointer transition"
            onclick="openEventDetail('<%= event.id %>')">

            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-2xl font-semibold"><%= event.name %></h2>
                <p class="text-gray-500"><%= event.location %></p>
              </div>

              <% if(event.isLive) { %>
                <div class="p-3 text-right rounded-full bg-green-600 text-white inline-block">Live</div>
              <% } else { %>
                <div class="p-3 text-right rounded-full bg-red-500 text-white inline-block">Niet Live</div>
              <% } %>

            </div>

          </div>

        <% }) %>

      </div>
    <% } %>
  </div>
</div>


<script type="module" src="/js/eventBeheer.js"></script>
<script type="module" src="/js/photonScript.js"></script>
