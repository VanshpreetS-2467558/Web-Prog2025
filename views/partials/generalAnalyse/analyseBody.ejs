<main class="pt-16 min-h-screen bg-gray-50">
    <div class="container mx-auto px-6 py-8 max-w-7xl">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="pb-2 text-4xl md:text-5xl font-bold mb-2 bg-gradientkleurBR bg-clip-text text-transparent">
                Algemene Analyse - FestCoin
            </h1>
            <p class="text-gray-600 text-lg">Bekijk algemene trends en inzichten over alle evenementen om je volgende event te plannen</p>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="flex items-center justify-center py-20">
            <div class="text-center">
                <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mb-4"></div>
                <p class="text-gray-600">Data wordt geladen...</p>
            </div>
        </div>

        <!-- Error State -->
        <div id="errorState" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            <p id="errorMessage"></p>
        </div>

        <!-- Content -->
        <div id="contentArea" class="hidden">
            <!-- Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="p-6 bg-gradientkleurSmallText text-white rounded-xl shadow-lg">
                    <p class="text-lg font-semibold mb-2">Totaal Bezoekers</p>
                    <div class="text-3xl font-bold" id="totalVisitors">0</div>
                    <p class="text-sm opacity-90 mt-1">Op alle evenementen</p>
                </div>
                <div class="p-6 bg-gradientkleurSmallText text-white rounded-xl shadow-lg">
                    <p class="text-lg font-semibold mb-2">Totale Omzet</p>
                    <div class="text-3xl font-bold" id="totalRevenue">€0</div>
                    <p class="text-sm opacity-90 mt-1">Totaal verkocht</p>
                </div>
                <div class="p-6 bg-gradientkleurSmallText text-white rounded-xl shadow-lg">
                    <p class="text-lg font-semibold mb-2">Items Verkocht</p>
                    <div class="text-3xl font-bold" id="totalItemsSold">0</div>
                    <p class="text-sm opacity-90 mt-1">Totaal items</p>
                </div>
                <div class="p-6 bg-gradientkleurSmallText text-white rounded-xl shadow-lg">
                    <p class="text-lg font-semibold mb-2">Evenementen</p>
                    <div class="text-3xl font-bold" id="eventsCount">0</div>
                    <p class="text-sm opacity-90 mt-1">Totaal evenementen</p>
                </div>
            </div>


            <!-- Charts Row 1 -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Top Cities Chart (Bar) -->
                <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Top 3 Steden (op Bezoekers)
                    </h2>
                    <div class="flex-1 flex items-center">
                        <canvas id="citiesChart" class="max-h-64"></canvas>
                    </div>
                </div>

                <!-- Category Sales Pie Chart -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
                        </svg>
                        Verkoop per Categorie (Omzet)
                    </h2>
                    <canvas id="categoryChart" class="max-h-80"></canvas>
                </div>
            </div>

            <!-- Charts Row 2 -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Category Quantity Bar Chart -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                        </svg>
                        Verkoop per Categorie (Aantal)
                    </h2>
                    <canvas id="categoryQuantityChart" class="max-h-80"></canvas>
                </div>

                <!-- Top Items Line Chart -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                        Top 5 Items Verkoop
                    </h2>
                    <canvas id="topItemsChart" class="max-h-80"></canvas>
                </div>
            </div>

            <!-- Category Statistics -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                    <svg class="w-6 h-6 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Detailanalyse per Categorie
                </h2>
                <div id="categoriesContainer" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Categories will be inserted here -->
                </div>
            </div>

            <!-- Top Items by Category -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                    <svg class="w-6 h-6 mr-2 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                    </svg>
                    Top Verkochte Items per Categorie
                </h2>
                <div id="topItemsContainer" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Top items will be inserted here -->
                </div>
            </div>

            <!-- Popular Cities List -->
            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                    <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Stad Rangschikking
                </h2>
                <div id="citiesContainer" class="space-y-4">
                    <!-- Cities will be inserted here -->
                </div>
            </div>

        </div>
    </div>
</main>

