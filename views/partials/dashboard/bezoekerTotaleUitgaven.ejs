<div class="grid md:grid-cols-2 mb-8 gap-4">
    <div class="border-2 shadow rounded-xl p-6">
        <h2 class="text-2xl font-bold mb-4">Uitgaven per categorie</h2>
        
        <% 
        const categoryData = typeof categorySpending !== 'undefined' ? categorySpending : [];
        const totalSpending = categoryData.reduce((sum, cat) => sum + (cat.total || 0), 0);
        const colors = {
            'Drank': '#8B5CF6',
            'Eten': '#F59E0B',
            'Others': '#10B981'
        };
        %>
        
        <!-- Category data for JavaScript -->
        <script id="categoryData" type="application/json" class="hidden"><%- JSON.stringify(categoryData) %></script>
        
        <% if (totalSpending > 0) { %>
            <!-- Pie Chart -->
            <div class="mb-6 flex justify-center">
                <canvas id="categoryChart" width="200" height="200"></canvas>
            </div>
            
            <!-- Legend -->
            <ul id="categoryLegend" class="space-y-2">
                <% categoryData.forEach(cat => { 
                    const percentage = totalSpending > 0 ? Math.round((cat.total / totalSpending) * 100) : 0;
                %>
                    <li class="flex justify-between items-center bg-gray-50 p-3 border border-purple-500 rounded">
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 rounded-full" style="background-color: <%= colors[cat.category] || '#6B7280' %>"></div>
                            <span><%= cat.category %></span>
                        </div>
                        <div class="text-right">
                            <span class="font-semibold"><%= cat.total %> FestCoins</span>
                            <span class="text-sm text-gray-500 ml-2">(<%= percentage %>%)</span>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <div class="text-center py-8 text-gray-500">
                <p>Nog geen uitgaven geregistreerd.</p>
            </div>
        <% } %>
    </div>
    
    <div class="border-2 shadow rounded-xl p-6">
        <h2 class="text-2xl font-bold mb-4">Evenement geschiedenis</h2>
        
        <% 
        const eventData = typeof eventSpending !== 'undefined' ? eventSpending : [];
        %>
        
        <div id="eventSpendingContainer">
            <% if (eventData.length > 0) { %>
                <div class="space-y-3">
                    <% eventData.forEach(event => { 
                        const maxSpending = eventData.length > 0 ? Math.max(...eventData.map(e => e.total)) : 1;
                        const barWidth = maxSpending > 0 ? (event.total / maxSpending) * 100 : 0;
                        const lastVisit = event.lastVisit ? new Date(event.lastVisit) : null;
                        const lastVisitStr = lastVisit ? lastVisit.toLocaleDateString('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
                    %>
                        <div class="event-card cursor-pointer hover:bg-gray-50 p-3 border border-purple-500 rounded transition-colors" 
                             data-event-id="<%= event.eventId %>"
                             onclick="showEventDetails(<%= event.eventId %>, '<%= event.eventName.replace(/'/g, "\\'") %>')">
                            <div class="flex justify-between items-center mb-2">
                                <div>
                                    <h3 class="font-semibold text-gray-800"><%= event.eventName %></h3>
                                    <% if (lastVisitStr) { %>
                                        <p class="text-xs text-gray-500">Laatste bezoek: <%= lastVisitStr %></p>
                                    <% } %>
                                </div>
                                <span class="font-bold text-purple-600"><%= event.total %> FestCoins</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-purple-500 h-2 rounded-full transition-all duration-300" 
                                     style="width: <%= barWidth %>%"></div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1"><%= event.transactionCount %> transactie(s)</p>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="text-center py-8 text-gray-500">
                    <p>Nog geen uitgaven bij evenementen.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Event Details Modal -->
<div id="eventDetailsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center modal-backdrop">
    <div class="bg-white rounded-2xl p-6 max-w-5xl w-full mx-4 shadow-xl max-h-[85vh] flex flex-col relative">
        <div class="flex justify-between items-center mb-4 sticky top-0 bg-white pb-2 border-b z-10">
            <h3 class="text-2xl font-bold text-gray-800" id="eventDetailsTitle">Event Details</h3>
            <button onclick="closeEventDetails()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100">&times;</button>
        </div>
        <div id="eventDetailsContent" class="flex-1 overflow-y-auto">
            <!-- Content will be loaded here -->
        </div>
    </div>
</div>

<script type="module" src="/js/bezoekerTotaleUitgaven.js"></script>
