<% if(user.role === "bezoeker") { %>

    <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="p-8 bg-gradientkleurBR text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">FestCoins</p>
            <div id="dashboardFestCoinsDisplay" class="text-3xl font-bold mb-1">
                <%= user.festCoins %>
            </div>
        </div>

        <div class="p-8 bg-gradientkleurBR text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">Vandaag besteed</p>
            <div id="todaySpendingDisplay" class="text-3xl font-bold mb-1">
                <%= typeof todaySpending !== 'undefined' ? todaySpending : 0 %>
            </div>
            <div class="text-sm opacity-90 mt-2">Transacties van vandaag</div>
            <div class="text-sm opacity-75 mt-3 pt-3 border-t border-white border-opacity-30">
                Totaal besteed: <span id="totalSpendingDisplay" class="font-semibold"><%= typeof totalSpending !== 'undefined' ? totalSpending : 0 %></span>
            </div>
        </div>
    </div>

<% } else if(user.role === "organisator" ) { %>

    <div class="grid md:grid-cols-4 gap-6 mb-8" id="infoCardsGrid">
        <div class="p-8 bg-gradientkleurSmallText text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">Totale Omzet</p>
            <div class="text-3xl font-bold mb-1" id="totalRevenue">0 FestCoins</div>
            <div class="text-1xl font-bold mb-1" id="totalRevenueEuro">€0</div>
        </div>

        <div class="p-8 bg-gradientkleurSmallText text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">Aantal bezoekers</p>
            <div class="text-3xl font-bold mb-1" id="totalVisitors">0</div>
        </div>

        <div id="eventTimerCard" class="p-8 bg-gradientkleurSmallText text-white rounded-lg shadow hidden">
            <p class="text-2xl font-bold mb-2">Evenement Timer</p>
            <div class="text-3xl font-bold mb-1" id="eventTimer">-</div>
            <div class="text-1xl font-bold mb-1" id="eventTimeRange">-</div>
        </div>

        <div class="p-8 bg-gradientkleurSmallText text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">Bezoekers vandaag</p>
            <div class="text-3xl font-bold mb-1" id="visitorsToday">0</div>
        </div>
    </div>

<% } else if(user.role === "employee"){  %>
    <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="p-8 bg-gradientkleurBR text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">Totale Omzet (<%= user.stationName %>)</p>
            <div class="text-3xl font-bold mb-1"><%= user.festCoins %></div>
            <div class="text-1xl font-bold mb-1"><%= user.festCoins %> Euro</div>
        </div>

        <div class="p-8 bg-gradientkleurBR text-white rounded-lg shadow">
            <p class="text-2xl font-bold mb-2">Evenement Timer</p>
            <div class="text-1xl font-bold mb-1">03:30u te gaan</div>
            <div class="text-1xl font-bold mb-1">22:30 - 03:00</div>
        </div>
    </div>
<% } %>