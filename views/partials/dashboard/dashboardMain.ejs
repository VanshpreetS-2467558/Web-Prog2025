<section class="container mx-auto max-w-full p-4 sm:p-6 md:p-14 border-2">

    <div class="mb-8">
        <div class="flex justify-between flex-col sm:flex-row items-center mb-4">
            <div>
                <h1 class="text-3xl font-bold mb-2">Welkom terug, <%= user.name %>!</h1>
                <% if(user.role === "bezoeker") { %>
                    <p class="text-gray-600">Bekijk rustig je overzicht.</p>
                <% } else if(user.role === "organisator") { %>
                    <p class="text-gray-600">Admin Dashboard - Live overzicht van je evenement</p>
                <% } else if(user.role === "employee") { %>
                    <p class="text-gray-600">Station Dashboard - Live overzicht van locatie: <%= user.stationName %></p>
                <% } %>
            </div>
            <% if(user.role === "organisator" && typeof events !== 'undefined' && events.length > 0) { %>
                <div class="flex justify-end w-full sm:w-auto mt-4 sm:mt-0 space-x-2">
                    <select id="eventSelect" class="border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Alle evenementen</option>
                        <% events.forEach(event => { %>
                            <option value="<%= event.id %>"><%= event.name %></option>
                        <% }); %>
                    </select>
                    <button id="exportPdfBtn" class="hidden md:inline-block bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors">
                        Exporteer naar PDF
                    </button>
                </div>
            <% } %>
        </div>
    </div>

    <!-- info kaarten -->
    <%- include("AlgemeneInfo") %>

    <% if(user.role === "bezoeker") { %>

        <!-- Tabs -->
        <div class="mb-8">
            <div class="border-b-2 border-gray-200">
                <div class="flex space-x-2 md:space-x-4">
                    <button onclick="showTab('analytics')" 
                            class="tab-btn-dashboard px-6 py-3 font-semibold border-b-2 border-purple-500 text-purple-500 transition-colors"
                            data-tab="analytics">
                        📊 Analytics
                    </button>
                    <button onclick="showTab('points')" 
                            class="tab-btn-dashboard px-6 py-3 font-semibold border-b-2 border-transparent text-gray-500 hover:text-purple-500 transition-colors"
                            data-tab="points">
                        ⭐ FestSparks
                    </button>
                    <button onclick="showTab('transactions')" 
                            class="tab-btn-dashboard px-6 py-3 font-semibold border-b-2 border-transparent text-gray-500 hover:text-purple-500 transition-colors"
                            data-tab="transactions">
                        📋 Transacties
                    </button>
                </div>
            </div>
        </div>

        <!-- Analytics Tab -->
        <div id="analyticsTab" class="tab-content-dashboard">
            <!-- uitgaven per categorie -->
            <%- include("bezoekerTotaleUitgaven") %>
        </div>

        <!-- Points Tab -->
        <div id="pointsTab" class="tab-content-dashboard hidden">
            <%- include("puntensysteem") %>
        </div>

        <!-- Transactions Tab -->
        <div id="transactionsTab" class="tab-content-dashboard hidden">
            <div id="transactionsTabContent">
                <!-- Content will be loaded here -->
            </div>
        </div>

    <% } else if(user.role === "organisator") { %>

        <!-- Verkopen vandaag -->
        <%- include("orgVerkochte") %>

    <% } else if(user.role === "employee") { %>
        
        <%- include("employeeDashboard") %>

    <% } %>

    <!-- Recente transacties (only show in analytics tab for bezoeker) -->
    <% if(user.role === "bezoeker") { %>
        <div id="recentTransactionsSection" class="tab-content-dashboard">
            <%- include("recenteTransacties") %>
        </div>
    <% } else { %>
        <%- include("recenteTransacties") %>
    <% } %>

</section>

<!-- Data for JavaScript -->
<div id="userRoleData" data-role="<%= user.role %>" class="hidden"></div>

<script type="module" src="/js/dashboardMain.js"></script>
