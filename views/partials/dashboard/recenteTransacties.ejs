<!-- Recente transacties -->
<div class="border-2 p-6 shadow">
    <h2 class="text-2xl font-bold mb-4">Recente transacties</h2>
    <!-- Support both dynamic loading (organizer) and EJS rendering (visitor) -->
    <div id="recentTransactions" class="space-y-3 mb-6">
        <div id="recentTransactionsList" class="space-y-3">
            <% 
            // For visitor: render from server-side data
            if (typeof user !== 'undefined' && user.role === 'bezoeker') {
                const transactionData = typeof recentTransactions !== 'undefined' ? recentTransactions : [];
                
                if (transactionData.length > 0) { 
                    transactionData.forEach(trans => { 
                        const date = new Date(trans.date);
                        const dateStr = date.toLocaleDateString('nl-NL', { day: '2-digit', month: '2-digit' });
                        const timeStr = date.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' });
                        const items = trans.items ? trans.items.split(' | ').slice(0, 2).join(', ') : 'Items';
                        const eventName = trans.eventName || 'Onbekend event';
                        const stationName = trans.stationName || 'Onbekend station';
            %>
                        <div class="flex justify-between items-center border-2 bg-gray-50 p-4 rounded shadow">
                            <div>
                                <p class="font-semibold">
                                    <%= items %><%= trans.items && trans.items.split(' | ').length > 2 ? '...' : '' %>
                                </p>
                                <p class="text-sm text-gray-500">
                                    <%= eventName %> • <%= stationName %> • <%= dateStr %> <%= timeStr %>
                                </p>
                            </div>
                            <p class="font-bold text-red-500">
                                -<%= trans.totalPrice %> FestCoins
                            </p>
                        </div>
            <%      }); 
                } else { %>
                    <div class="text-center py-8 text-gray-500">
                        <p>Nog geen transacties.</p>
                    </div>
            <%  }
            } else { %>
                <!-- For organizer: will be loaded dynamically -->
                <p class="text-gray-500">Laden...</p>
            <% } %>
        </div>
    </div>
    
    <button id="viewAllTransactionsBtn" class="w-full p-3 text-white border-2 bg-gradientkleurBR rounded-lg font-semibold hover:opacity-90 transition-opacity">
        Bekijk alle transacties
    </button>
</div>

<!-- All Transactions Modal -->
<div id="allTransactionsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center modal-backdrop">
    <div class="bg-white rounded-2xl p-6 max-w-3xl w-full mx-4 shadow-xl max-h-[80vh] flex flex-col relative">
        <div class="flex justify-between items-center mb-4 sticky top-0 bg-white pb-2 border-b">
            <h3 class="text-2xl font-bold text-gray-800">Alle Transacties</h3>
            <button id="closeModalBtn" onclick="closeAllTransactions()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100">&times;</button>
        </div>
        <!-- Support both IDs for compatibility -->
        <div id="allTransactionsList" class="overflow-y-auto flex-1">
            <div id="allTransactionsContent" class="text-center py-4">
                <p class="text-gray-500">Laden...</p>
            </div>
        </div>
    </div>
</div>