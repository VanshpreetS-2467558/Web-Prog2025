<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="p-6 lg:col-span-2 bg-white rounded-lg shadow">
        <h2 class="text-2xl font-bold mb-6">📈 Verkopen vandaag, locatie <%= user.stationName %></h2>
        <div id="salesChart" class="flex items-end h-48 space-x-2"></div>
        <div id="salesChartLabels" class="flex justify-between text-sm mt-2 text-gray-500"></div>
    </div>

    <div class="p-6 bg-white rounded-lg shadow">
        <h2 class="text-2xl font-bold mb-6">🛒 Populairste items, <%= user.stationName %></h2>
        <div id="popularItems" class="space-y-4"></div>
    </div>
</div>


<div id="salesModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
  <div class="bg-white p-6 rounded-lg shadow-lg w-80">
    <h2 class="text-xl font-bold mb-2" id="modalHour">-</h2>
    <p id="modalSales">Totale FestCoins: -</p>
    <p id="modalCount">Aantal transacties: -</p>
    <button onclick="closeModal()" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded">Sluiten</button>
  </div>
</div>