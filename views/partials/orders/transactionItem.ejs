<div class="flex justify-between items-center py-2 border-b last:border-b-0">
    <div class="flex-1">
        <p class="font-medium"><%= item.itemName %></p>
        <div class="flex gap-4 text-sm text-gray-500 mt-1">
            <span>Station: <%= item.stationName %></span>
            <span>Categorie: <%= item.category %></span>
        </div>
    </div>
    <div class="text-right ml-4">
        <p class="font-semibold"><%= item.quantity %>x</p>
        <p class="text-sm text-gray-500"><%= item.itemPrice %> FestCoins per stuk</p>
        <p class="text-lg font-bold text-blue-600"><%= item.itemTotal %> FestCoins</p>
    </div>
</div>

