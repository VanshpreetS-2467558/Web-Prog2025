<div class="min-h-screen bg-gray-50 pb-24">
  <!-- Navbar -->
  <nav class="border-b bg-white shadow-sm sticky top-0 z-10">
    <div class="container mx-auto px-4 py-4 flex justify-between flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-4">
      <div class="flex-2">
        <h1 class="text-xl font-bold"><%= event.name %></h1>
        <p class="text-sm text-gray-500">Selecteer items uit het menu</p>
      </div>
      <div class="flex justify-between sm:justify-end items-center gap-4 sm:gap-4 w-full">
        <div class="px-4 py-2 bg-gradient-to-br from-blue-500/10 to-purple-500/10 rounded-lg border border-blue-200">
          <p class="text-sm text-gray-600">Mijn FestCoins</p>
          <p id="eventFestCoins" class="text-xl font-bold bg-gradientkleurBR bg-clip-text text-transparent"><%= user.festCoins %></p>
        </div>
        <form action="/list/events/<%= event.id %>/leave" method="POST" class="inline">
          <button type="submit" 
                  class="px-3 py-2 border rounded-lg bg-red-500 text-white hover:bg-red-400"
                  onclick="localStorage.removeItem('cart'); localStorage.removeItem('currentStation')">
            Verlaat evenement
          </button>
        </form>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <div class="container mx-auto px-4 py-6">
    <!-- Tabs -->
    <div class="w-full">
      <div class="flex gap-2 overflow-x-auto mb-6 border-b pb-2">
        <% stations.forEach((section, i) => { %>
          <button 
            class="tab-btn px-4 py-2 rounded <% if(i===0){ %>bg-blue-500 text-white<% } else { %>bg-gray-300<% } %>"
            data-tab="<%= section.id %>">
            <%= section.name %>
          </button>
        <% }) %>
      </div>

      <% stations.forEach((section, i) => { %>
        <div class="tab-content <% if(i!==0){ %>hidden<% } %>" data-tab-content="<%= section.id %>">
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <% section.items.forEach(item => { %>
              <div class="border rounded-lg bg-white shadow-sm p-4 flex flex-col justify-between" data-item-id="<%= item.id %>">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="font-bold text-2xl"><%= item.name %></h3>
                  <span class="px-2 py-1 text-xs font-medium rounded <%= item.stock === 0 ? 'bg-gray-500 text-white' : (item.stock > 50 ? 'bg-green-700 text-white' : 'bg-red-100 text-red-700') %>" data-stock>
                    <%= item.stock === 0 ? 'Out of stock' : item.stock + ' op voorraad' %>
                  </span>
                </div>
                <div class="flex justify-between items-center mt-2">
                  <p class="text-2xl font-bold bg-gradientkleurBR bg-clip-text text-transparent"><%= item.price %> FestCoins</p>
                  <% if (item.stock === 0) { %>
                    <button class="flex items-center px-3 py-1 bg-gray-400 text-white rounded cursor-not-allowed" disabled>
                      Out of stock
                    </button>
                  <% } else { %>
                    <button class="flex items-center px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600"
                            onclick="addToCartItem(<%= JSON.stringify({...item, sectionName: section.name}) %>)">
                      + Toevoegen
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Fixed Cart Bar -->
<%- include("winkelwagen") %>

<!-- Bestel bevestiging popup -->
<%- include("bevestigingPopup") %>

<!-- Groepspot popup -->
<%- include("groepspot") %>

<!-- QR Active Order popup -->
<%- include("qr-dialog") %>

<!-- Data for JavaScript -->
<div id="userData" data-festcoins="<%= user.festCoins %>" data-id="<%= user.id %>" class="hidden"></div>
<div id="eventData" data-eventid="<%= event.id %>" data-eventenddate="<%= event.endDate %>" class="hidden"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script type="module" src="/js/itemListData.js"></script>
<script type="module" src="/js/itemListScripts.js"></script>
