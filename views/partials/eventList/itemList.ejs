<div class="min-h-screen bg-gray-50 pb-24">
  <!-- Navbar -->
  <nav class="border-b bg-white shadow-sm sticky top-0 z-10">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div>
        <h1 class="text-xl font-bold"><%= event.name %></h1>
        <p class="text-sm text-gray-500">Selecteer items uit het menu</p>
      </div>
      <form action="/events/<%= event.id %>/leave" method="POST" class="inline">
        <button type="submit" 
                class="px-3 py-2 border rounded-lg bg-red-500 text-white hover:bg-red-400"
                onclick="localStorage.removeItem('cart'); localStorage.removeItem('currentStation')">
          Verlaat evenement
        </button>
      </form>
    </div>
  </nav>

  <!-- Content -->
  <div class="container mx-auto px-4 py-6">
    <!-- Tabs -->
    <div class="w-full">
      <div class="flex gap-2 overflow-x-auto mb-6 border-b pb-2">
        <% stations.forEach((section, i) => { %>
          <button 
            class="tab-btn px-4 py-2 rounded <% if(i===0){ %>bg-blue-500 text-white<% } else { %>bg-gray-300<% } %>"
            data-tab="<%= section.id %>">
            <%= section.name %>
          </button>
        <% }) %>
      </div>

      <% stations.forEach((section, i) => { %>
        <div class="tab-content <% if(i!==0){ %>hidden<% } %>" data-tab-content="<%= section.id %>">
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <% section.items.forEach(item => { %>
              <div class="border rounded-lg bg-white shadow-sm p-4 flex flex-col justify-between">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="font-bold text-2xl"><%= item.name %></h3>
                  <span class="px-2 py-1 text-xs font-medium rounded <%= item.stock > 50 ? 'bg-green-700 text-white' : 'bg-red-100 text-red-700' %>">
                    <%= item.stock %> op voorraad
                  </span>
                </div>
                <div class="flex justify-between items-center mt-2">
                  <p class="text-2xl font-bold bg-gradientkleurBR bg-clip-text text-transparent"><%= item.price %> FestCoins</p>
                  <button class="flex items-center px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600"
                          onclick="addToCartItem(<%= JSON.stringify({...item, sectionName: section.name}) %>)">
                    + Toevoegen
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Fixed Cart Bar -->
<div id="cartContainer" class="fixed bottom-0 left-0 right-0 bg-white border-t shadow-lg p-4 z-20">
  <div class="container mx-auto">
    <p id="emptyCartMsg" class="text-center text-gray-500">Winkelwagen is leeg</p>
    <div id="cartItems" class="space-y-4 hidden"></div>

    <div class="flex gap-2 mt-2 hidden" id="cartButtons">
      <button id="groupPotBtn" class="flex-1 px-4 py-2 border rounded hover:bg-gray-100" onclick="openGroup()">Groepspot (0 items)</button>
      <button id="qrBtn" class="flex-1 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" onclick="openQR()">QR Code (€0.00)</button>
    </div>
  </div>
</div>

<!-- bestel Code Modal -->
<div id="bestelDialog" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-30">
  <div class="bg-white rounded-lg max-w-md w-full p-6">
    <h2 class="text-xl font-bold mb-4">Jouw Bestelling</h2>
    <!-- Items overzicht -->
    <div id="orderItems" class="space-y-2 max-h-64 overflow-y-auto mb-4">
      <!-- items komen hier dynamisch -->
    </div>
    <!-- Totaal -->
    <div class="flex justify-between font-semibold text-lg mb-4">
      <span>Totaal:</span>
      <span id="orderTotal" class="bg-gradientkleurBR bg-clip-text text-transparent">0 FestCoins</span>
    </div>
    <!-- Knoppen -->
    <button class="w-full bg-blue-600 text-white py-2 rounded mb-2" onclick="placeOrder()">Bestel</button>
    <button onclick="document.getElementById('bestelDialog').classList.add('hidden')" class="w-full py-2 bg-gray-200 rounded">Sluiten</button>
  </div>
</div>


<!-- Groepspot Modal -->
<div id="groupDialog" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-30">
  <div class="bg-white rounded-lg max-w-md w-full p-6 space-y-4">
    <h2 class="text-2xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">Groepspot Aanmaken</h2>
    <p class="text-gray-900">Deel de kosten met je vrienden</p>
    <div class="bg-gray-100 p-4 rounded">
      <p class="text-sm mb-1">Totaal te betalen:</p>
      <p class="text-3xl font-bold bg-gradientkleurBR bg-clip-text text-transparent" id="groupTotal">0 FestCoins</p>
      <p class="text-sm text-gray-500 mt-1" id="groupItems">0 items</p>
    </div>
    <p class="font-medium mb-2">Laat vrienden scannen om bij te dragen:</p>
    <div class="bg-white p-6 rounded-lg mx-auto w-fit border-2 border-dashed">
      <div class="w-48 h-48 bg-gray-200 flex items-center justify-center">QR CODE</div>
    </div>
    <div class="space-y-3">
      <div class="flex justify-between items-center p-3 bg-gray-100 rounded">
        <span class="text-sm">Jouw bijdrage:</span>
        <input type="number" class="w-24 px-3 py-1 border rounded text-right" placeholder="0">
      </div>
      <div class="flex justify-between items-center p-3 bg-green-50 rounded">
        <span class="text-sm font-medium">Nog te betalen:</span>
        <span class="font-bold text-green-600" id="groupRemaining">0 FestCoins</span>
      </div>
    </div>
    <button class="w-full bg-gray-300 rounded p-2" disabled>Wachten op vrienden...</button>
    <button onclick="document.getElementById('groupDialog').classList.add('hidden')" class="mt-2 px-4 py-2 bg-gray-200 rounded w-full">Sluiten</button>
  </div>
</div>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- State ---
    let cart = JSON.parse(localStorage.getItem('cart')) || [];
    let currentStation = localStorage.getItem('currentStation') || null;

    // --- Helpers ---
    function saveCart() {
      localStorage.setItem('cart', JSON.stringify(cart));
    }

    function renderCart() {
      const cartItems = document.getElementById('cartItems');
      const emptyMsg = document.getElementById('emptyCartMsg');
      const cartButtons = document.getElementById('cartButtons');

      if (!cart || cart.length === 0) {
        cartItems.classList.add('hidden');
        emptyMsg.classList.remove('hidden');
        cartButtons.classList.add('hidden');
        return;
      }

      cartItems.innerHTML = cart.map(item => `
        <div class="flex justify-between items-center bg-gray-100 p-2 rounded">
          <div class="flex-1">
            <p class="font-medium">${item.name}</p>
            <p class="text-xs text-gray-500">${item.sectionName || ''}</p>
          </div>
          <div class="flex items-center gap-3">
            <button class="px-2 py-1 border rounded text-sm" onclick="removeFromCart(${item.id})">-</button>
            <span class="font-medium w-8 text-center">${item.quantity}x</span>
            <button class="px-2 py-1 bg-blue-500 text-white rounded text-sm" onclick='addToCartItem(${JSON.stringify(item)})'>+</button>
            <p class="font-semibold text-right bg-gradientkleurBR bg-clip-text text-transparent">${(item.price * item.quantity)} FestCoins</p>
          </div>
        </div>
      `).join('');

      cartItems.classList.remove('hidden');
      emptyMsg.classList.add('hidden');
      cartButtons.classList.remove('hidden');
    }

    function updateCartTotals() {
      const totalPrice = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);
      const totalItems = cart.reduce((sum, i) => sum + i.quantity, 0);

      const qrTotalEl = document.getElementById('qrTotal');
      const qrItemsEl = document.getElementById('qrItems');
      const groupPotBtn = document.getElementById('groupPotBtn');
      const qrBtn = document.getElementById('qrBtn');

      if (qrTotalEl) qrTotalEl.textContent = `${totalPrice} FestCoins`;
      if (qrItemsEl) qrItemsEl.textContent = `${totalItems} items in bestelling`;
      if (groupPotBtn) groupPotBtn.textContent = `Groepspot (${totalItems} items)`;
      if (qrBtn) qrBtn.textContent = `Bestel (${totalPrice} FestCoins)`;
    }

    function updateGroupDialog() {
      const totalPrice = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);
      const totalItems = cart.reduce((sum, i) => sum + i.quantity, 0);
      const groupTotal = document.getElementById('groupTotal');
      const groupItems = document.getElementById('groupItems');
      const groupRemaining = document.getElementById('groupRemaining');

      if (groupTotal) groupTotal.textContent = `${totalPrice} FestCoins`;
      if (groupItems) groupItems.textContent = `${totalItems} items`;
      if (groupRemaining) groupRemaining.textContent = `${totalPrice} FestCoins`;
    }

    // --- Cart ops (exposed to global because used in onclick attributes) ---
    window.addToCartItem = function(item) {
      // haal huidige totaal op
      const currentTotal = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);

      // controleer of je genoeg FestCoins hebt
      if (currentTotal + item.price > <%= user.festCoins %>) {
        alert("Niet genoeg saldo!");
        return; // stop hier
      }

      // toevoegen aan cart
      const existing = cart.find(i => i.id === item.id);
      if (existing) existing.quantity++;
      else cart.push({...item, quantity: 1});

      saveCart();
      renderCart();
      updateCartTotals();
      updateGroupDialog();
    };


    window.removeFromCart = function(itemId) {
      const idx = cart.findIndex(i => i.id === itemId);
      if (idx === -1) return;
      cart[idx].quantity--;
      if (cart[idx].quantity <= 0) cart.splice(idx, 1);
      saveCart();
      renderCart();
      updateCartTotals();
      updateGroupDialog();
    };

    // --- Order dialog (hernoemd en werkt met nieuwe HTML) ---
    function renderOrderDialog() {
      const container = document.getElementById('orderItems');
      const total = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);
      if (!container) return;
      container.innerHTML = cart.map(item => `
        <div class="flex justify-between items-center bg-gray-100 p-2 rounded">
          <p>${item.quantity}x ${item.name}</p>
          <p class="font-semibold ">${item.price * item.quantity} FestCoins</p>
        </div>
      `).join('');
      const orderTotalEl = document.getElementById('orderTotal');
      if (orderTotalEl) orderTotalEl.textContent = `${total} FestCoins`;
    }

    window.placeOrder = function() {
      alert("Bestelling geplaatst!");
      cart = [];
      saveCart();
      renderCart();
      updateCartTotals();
      updateGroupDialog();
      const dlg = document.getElementById('bestelDialog');
      if (dlg) dlg.classList.add('hidden');
    };

    window.openQR = function() {
      renderOrderDialog();
      const dlg = document.getElementById('bestelDialog');
      if (dlg) dlg.classList.remove('hidden');
    };

    window.openGroup = function() {
      const dlg = document.getElementById('groupDialog');
      if (dlg) dlg.classList.remove('hidden');
    };

    // --- Tabs (single unified handler) ---
    document.querySelectorAll('[data-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        const clickedStation = btn.dataset.tab;

        // reset cart wanneer van station verandert
        if (currentStation && currentStation !== clickedStation && cart.length > 0) {
          alert("Je verandert van station. Winkelmandje wordt geleegd.");
          cart = [];
          saveCart();
          renderCart();
          updateCartTotals();
          updateGroupDialog();
        }

        currentStation = clickedStation;
        localStorage.setItem('currentStation', clickedStation);

        // visuele tab update
        document.querySelectorAll('[data-tab]').forEach(b => {
          b.classList.remove('bg-blue-500','text-white');  // verwijder actief
          b.classList.add('bg-gray-300','text-black');     // zet inactief
        });

        btn.classList.remove('bg-gray-300','text-black');  // verwijder inactief van geklikte
        btn.classList.add('bg-blue-500','text-white');     // zet actief


        document.querySelectorAll('[data-tab-content]').forEach(c => c.classList.add('hidden'));
        const content = document.querySelector(`[data-tab-content="${clickedStation}"]`);
        if (content) content.classList.remove('hidden');
      });
    });

    // --- Init render ---
    renderCart();
    updateCartTotals();
    updateGroupDialog();
  });
</script>

