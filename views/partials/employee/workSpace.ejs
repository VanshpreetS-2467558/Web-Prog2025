<div class="flex flex-col min-h-screen bg-gray-100 font-sans">

    <!-- Bovenbalk: Leave knop + Titel -->
    <div class="flex justify-between items-center px-4 py-3 bg-white shadow">
        <h1 class="text-3xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">
            WorkSpace
        </h1>
        <a href="/dashboard" class="px-4 py-2 bg-red-500 text-white rounded-lg shadow hover:bg-red-600 transition">
            Verlaat WorkSpace
        </a>
    </div>

    <!-- Camera container vult de rest van scherm -->
    <div class="relative flex-grow w-full" style="height: calc(100vh - 64px);">
        <video id="video" autoplay playsinline class="w-full h-full object-cover"></video>

        <!-- Scanvakje overlay -->
        <div class="absolute top-1/2 left-1/2 w-64 h-64 -translate-x-1/2 -translate-y-1/2 border-4 border-dashed border-green-500 rounded-lg"></div>

        <!-- Output box onderaan video -->
        <div id="output" class="absolute bottom-10 left-1/2 -translate-x-1/2 bg-white text-gray-900 px-6 py-3 rounded-xl shadow text-center"></div>
        
        <!-- Manual code input button -->
        <button id="manualCodeBtn" onclick="showManualCodeInput()" class="absolute top-4 right-4 bg-blue-500 text-white px-4 py-2 rounded-lg shadow hover:bg-blue-600 transition">
            Code invoeren
        </button>
        
        <!-- Manual code input modal -->
        <div id="manualCodeModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
            <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
                <h2 class="text-xl font-bold mb-4">Bestelling code invoeren</h2>
                <p class="text-sm text-gray-600 mb-4">Voer de 6-cijferige code in van de bestelling:</p>
                <input type="text" id="manualOrderCode" maxlength="6" pattern="[0-9]{6}" class="w-full border rounded-lg p-3 text-2xl font-mono text-center mb-4" placeholder="000000">
                <div class="flex gap-2">
                    <button onclick="hideManualCodeInput()" class="flex-1 px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">Annuleren</button>
                    <button onclick="submitManualCode()" class="flex-1 px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">Verzenden</button>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("scanPopup")%>

<script src="https://cdn.jsdelivr.net/npm/jsqr/dist/jsQR.js"></script>
<script src="/js/scanQRScript.js"></script>