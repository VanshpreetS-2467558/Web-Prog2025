<!-- views/transactionPopup.ejs -->
<div id="transactionPopup" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative min-h-screen flex flex-col justify-between">
        <!-- Titel -->
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-green-600 mb-4 text-center">
                Transactie succesvol opgehaald
            </h2>
        </div>
        <!-- Itemlijst  (dynamisch ingevuld) -->
        <div class="mb-8 flex-1 overflow-y-auto text-lg">
            <p class="font-semibold mb-2">Items van transactie:</p>
            <ul id="orderItemsList" class="list-disc list-inside text-gray-700 space-y-1">
                <!-- Items worden hier dynamisch ingevuld -->
            </ul>
        </div>


        <!-- Bevestig knop -->
        <div class="flex justify-center mx-auto">
            <button id="confirmBtn" class="px-8 py-4 text-lg bg-blue-500 text-white rounded-xl shadow hover:bg-blue-600 transition">
                Bestelling uitgereikt!
            </button>
        </div>
    </div>
</div>
