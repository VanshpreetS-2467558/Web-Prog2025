<!-- Centered button to open modal with auto width -->
<button id="showFormWerknemer" type="button"
    class="bg-gradientkleurR text-white py-3 px-8 rounded-lg font-semibold hover:opacity-90 shadow-md transition-all duration-300 hover:shadow-lg hover:scale-105">
  ➜ Werknemer account aanmaken
</button>


<!-- Modal overlay (initially hidden) -->
<section id="nieuweWerknemerForm" class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden transition-opacity duration-300">
  <div class="w-full max-w-2xl bg-white p-8 rounded-2xl shadow-2xl relative transform transition-all duration-300 scale-100">
    
    <!-- Close button -->
    <button id="closeFormWerknemer" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-3xl font-bold transition-colors duration-200 w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100">&times;</button>

    <div class="flex flex-col items-center mb-8">
      <a href="/home" class="text-5xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">
        FestCoin
      </a>
      <h2 class="text-xl font-semibold mt-3 mb-2 text-gray-700">Maak hier een account aan voor je werknemers.</h2>
    </div>

    <!-- Registration form -->
    <form id="registratieform" class="space-y-4" novalidate>
      <!-- Naam -->
      <div>
        <label for="name" class="block mb-2 font-medium text-gray-700">Gebruikersnaam</label>
        <input type="text" name="name" id="name" maxlength="30" required
               class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200"
               placeholder="Artuurtje">
      </div>

      <!-- Wachtwoord -->
      <div>
        <label for="password" class="block mb-2 font-medium text-gray-700">Wachtwoord</label>
        <p class="text-xs text-gray-500 mb-2">(Gebruik minimaal 8 tekens, met een hoofdletter, kleine letter, cijfer en speciaal teken.)</p>
        <input type="password" id="password" name="password" maxlength="100" required
               class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200"
               placeholder="•••••••••••">
      </div>

      <!-- Bevestig wachtwoord -->
      <div>
        <label for="confirmPassword" class="block mb-2 font-medium text-gray-700">Bevestig wachtwoord</label>
        <input id="confirmPassword" name="confirmPassword" type="password" maxlength="100" required
               class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200"
               placeholder="•••••••••••">
      </div>

      <!-- Evenement dropdown -->
      <div>
        <label for="evenement" class="block mb-2 font-medium text-gray-700">Evenement</label>
        <select id="evenement" name="evenement" required
                class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200 bg-white">
          <option value="">Selecteer een evenement</option>
        </select>
      </div>

      <!-- Station dropdown (initially hidden) -->
      <div id="stationWrapper" class="hidden">
        <label for="station" class="block mb-2 font-medium text-gray-700">Station</label>
        <select id="station" name="station" required
                class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200 bg-white">
          <option value="">Selecteer een station</option>
        </select>
      </div>

      <!-- Submit button -->
      <button type="submit"
              class="w-full bg-gradientkleurR text-white py-3 rounded-lg font-semibold hover:opacity-90 shadow-md transition-all duration-200 hover:shadow-lg mt-2">
        Account aanmaken ➜
      </button>

      <!-- Error message -->
      <p id="errorMsg" class="font-thin text-red-600"></p>
    </form>

    <div class="mt-8 pt-6 border-t border-gray-200">
      <p class="text-xs text-gray-500 text-center">
        Door een account aan te maken ga je akkoord met onze
        <a href="/voorwaarden" class="text-blue-600 hover:underline">Algemene voorwaarden</a> en
        <a href="/privacy" class="text-blue-600 hover:underline">Privacybeleid</a>.
      </p>
    </div>
  </div>
</section>

<script type="module" src="/js/newEmployee.js"></script>
