<section class="container mx-auto py-10 max-w-4xl">
    <div class="border rounded-2xl p-6 shadow-sm mb-8">
        <!-- Card Header -->
        <div class="mb-4 flex justify-between items-center">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
            <i class="fa-solid fa-history"></i>
            Transactie Geschiedenis
            </h2>
            <button onclick="openAllTransactions()" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 text-sm">
                Alle transacties
            </button>
        </div>

        <!-- Card Content -->
        <div class="space-y-3" id="transactionsList">
            <% if(transactions && transactions.length > 0) { %>
                <% transactions.forEach(transaction => { %>
                <div class="flex justify-between items-center p-3 bg-gray-100 rounded-lg">
                    <div class="flex items-center gap-3">
                    <% if(transaction.type === 'buy') { %>
                        <i class="fa-solid fa-arrow-down-left text-green-500"></i>
                        <div>
                            <p class="font-medium">FestCoins gekocht</p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } else if(transaction.type === 'sell') { %>
                        <i class="fa-solid fa-arrow-up-right text-red-500"></i>
                        <div>
                            <p class="font-medium">FestCoins verkocht</p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } else if(transaction.type === 'send') { %>
                        <i class="fa-solid fa-paper-plane text-blue-500"></i>
                        <div>
                            <p class="font-medium">FestCoins gestuurd</p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } else if(transaction.type === 'receive') { %>
                        <i class="fa-solid fa-inbox text-green-500"></i>
                        <div>
                            <p class="font-medium">FestCoins ontvangen</p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } else if(transaction.type === 'groepspot') { %>
                        <i class="fa-solid fa-users text-purple-500"></i>
                        <div>
                            <p class="font-medium">Groepspot bijdrage</p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } else if(transaction.type === 'reward') { %>
                        <i class="fa-solid fa-star text-yellow-500"></i>
                        <div>
                            <p class="font-medium"><%= transaction.description || 'FestSpark BONUS' %></p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } else { %>
                        <i class="fa-solid fa-question text-gray-500"></i>
                        <div>
                            <p class="font-medium"><%= transaction.description || 'Onbekende transactie' %></p>
                            <p class="text-sm text-gray-500"><%= new Date(transaction.createdAt).toLocaleString('nl-NL') %></p>
                        </div>
                    <% } %>
                    </div>

                    <div class="text-right">
                    <p class="font-semibold <%= transaction.amount > 0 ? 'text-green-600' : 'text-red-600' %>">
                        <%= transaction.amount > 0 ? '+' : '' %><%= transaction.amount %> FestCoins
                    </p>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <p class="text-gray-500 text-center py-4">Geen transacties gevonden</p>
            <% } %>
        </div>
    </div>
</section>

<!-- All Transactions Popup -->
<div id="allTransactionsPopup" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 hidden modal-backdrop">
    <div class="bg-white rounded-xl shadow-lg w-4/5 md:w-2/3  max-w-4xl max-h-[85vh] overflow-hidden flex flex-col">
        <div class="flex justify-between items-center px-6 py-4 border-b sticky top-0 bg-white z-10">
            <h2 class="text-2xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">Alle FestCoin Transacties</h2>
            <button onclick="closeAllTransactions()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100">&times;</button>
        </div>
        <div class="overflow-y-auto p-6 space-y-3 flex-1 border-2 border-gray-300 rounded-lg" id="allTransactionsList" style="max-height: calc(85vh - 120px);">
            <!-- Transactions will be loaded here -->
        </div>
    </div>
</div>

