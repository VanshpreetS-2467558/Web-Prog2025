
<div class="container mx-auto pb-4 max-w-4xl">
    
    <div class="border-gray-400 shadow text-center p-2 mb-10 bg-gradient-to-br from-indigo-200 via-white to-pink-200">
        <h2 class="text-3xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">FestGroup</h2>
        <p class="text-gray-500 mb-5">klik hier om bij te dragen bij een groepspot!</p>
        <button class="m-3 bg-purple-500 text-white px-4 py-2 rounded-lg hover:bg-purple-600" onclick="openScanField()">Fest Scanner</button>
    </div>
    
    <!-- Tabs -->
    <div class="mb-8 p-4 border-gray-400 shadow">
        <div class="grid grid-cols-3 bg-gray-100">
            <button class="tab-btn py-2 font-semibold border-b-2 border-purple-400 text-purple-500" data-tab="buy">Kopen</button>
            <button class="tab-btn py-2 font-semibold border-b-2 text-gray-500" data-tab="sell">Verkopen</button>
            <button class="tab-btn py-2 font-semibold border-b-2 text-gray-500" data-tab="send">Deel FestCoins</button>
        </div>
    </div>

    <div class="min-h-[385px]">

        <!-- Kopen -->
        <%- include ("kopenTab") %>

        <!-- Verkopen -->
        <%- include ("verkopenTab") %>
        
        <!-- deel -->
        <%- include ("shareTab") %>

    </div>
</div>

<%- include("scanFieldPopUp") %>
<script type="module" src="/js/festCoinsTabsScripts.js"></script>