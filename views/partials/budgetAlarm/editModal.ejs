<div id="editModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full mx-4 shadow-xl">
        <h3 class="text-xl font-bold mb-4 text-gray-800">Budget Alarm Bewerken</h3>
        <form id="editAlarmForm" class="space-y-4">
            <input type="hidden" id="editAlarmId" name="alarmId">
            <div>
                <label for="editAlarmCategory" class="block text-sm font-medium text-gray-700 mb-2">Categorie</label>
                <select id="editAlarmCategory" name="category" required class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-purple-500 focus:border-purple-500" disabled>
                    <option value="Drank">Drank</option>
                    <option value="Eten">Eten</option>
                    <option value="Others">Others</option>
                </select>
            </div>
            <div>
                <label for="editAlarmBudgetLimit" class="block text-sm font-medium text-gray-700 mb-2">Budget Limiet (FestCoins)</label>
                <input type="number" id="editAlarmBudgetLimit" name="budgetLimit" min="0" step="1" required 
                       class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                       placeholder="Bijv. 500">
            </div>
            <div class="flex gap-3">
                <button type="submit" class="flex-1 bg-purple-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-600 transition-colors">
                    Opslaan
                </button>
                <button type="button" onclick="closeEditModal()" class="flex-1 bg-gray-200 text-gray-800 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition-colors">
                    Annuleren
                </button>
            </div>
        </form>
    </div>
</div>

