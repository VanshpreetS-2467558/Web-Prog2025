<div id="addItemForm" class="fixed inset-0 bg-black/50 flex items-start justify-center pt-20 z-50 hidden">
  <div class="bg-white p-6 rounded-xl w-80">
    <h2 class="text-xl font-semibold mb-3">Nieuw Item</h2>

    <form id="itemForm">
      <input type="hidden" id="sectionIdInput">

      <label class="text-sm">Item Naam</label>
      <input type="text" id="itemName" class="w-full border rounded p-2 mb-2" required>

      <label class="text-sm">Prijs</label>
      <input type="number" step="0.01" id="itemPrice" class="w-full border rounded p-2 mb-2" required>

      <label class="text-sm">Voorraad</label>
      <input type="number" id="itemStock" class="w-full border rounded p-2 mb-4" required>

      <div class="flex justify-between gap-2">
        <button type="button" class="bg-red-500 text-white px-4 py-2 rounded-lg w-full hover:bg-red-700"
                onclick="document.getElementById('addItemForm').classList.add('hidden')">
          Annuleren
        </button>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg w-full hover:bg-blue-700">Toevoegen</button>
      </div>
      <p id="errorMsgAddItem" class="font-thin text-red-600"></p>
    </form>
  </div>
</div>
