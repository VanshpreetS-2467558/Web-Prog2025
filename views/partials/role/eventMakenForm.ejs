<!-- Event Form Modal -->
<div id="EventAanmaakTab" class="fixed inset-0 bg-black/50 flex justify-center items-start pt-20 z-50 hidden">
    <div class="bg-white rounded-xl p-6 w-full max-w-2xl">
        <h3 class="text-xl font-semibold mb-2">Nieuw Evenement Aanmaken</h3>
        <p class="text-gray-500 mb-4">Vul de gegevens van je evenement in</p>

        <form id="eventAanmaakForm" class="grid gap-4">
            <div class="grid gap-2">
                <label for="name">Naam *</label>
                <input id="name" name="name" class="border rounded-lg px-3 py-2" required>
            </div>

            <div class="grid gap-2">
                <label for="location">Locatie *</label>
                <input id="location" name="location" class="border rounded-lg px-3 py-2" required>
            </div>

            <div class="grid gap-2">
                <label for="description">Beschrijving</label>
                <textarea id="description" name="description" class="border rounded-lg px-3 py-2"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="grid gap-2">
                    <label for="startDate">Start Datum & Tijd *</label>                    
                    <input type="date" id="startDate" name="startDate" class="border rounded-lg px-3 py-2" required>
                    <input type="time" id="startTime" name="startTime" class="border rounded-lg px-3 py-2" required>
                </div>
                <div class="grid gap-2">
                    <label for="endDate">Eind Datum & Tijd *</label>
                    <input type="date" id="endDate" name="endDate" class="border rounded-lg px-3 py-2" required>
                    <input type="time" id="endTime" name="endTime" class="border rounded-lg px-3 py-2" required>
                </div>
            </div>

            <p id="errorMsgEvent" class="font-thin text-red-600 text-right mt-4"></p>
            <div class="flex justify-end gap-2">
                <button type="button" class="px-4 py-2 border rounded-lg bg-red-500 text-white font-semibold" onclick="document.getElementById('EventAanmaakTab').classList.add('hidden')">Annuleren</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg">Evenement Aanmaken</button>
            </div>
        </form>
    </div>
</div>
