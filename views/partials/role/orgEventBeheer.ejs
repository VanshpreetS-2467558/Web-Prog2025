<%- include("locatieAddForm") %>
<%- include("eventMakenForm") %>
<%- include("itemAddForm") %>

<div class="container mx-auto p-10 min-h-screen">

  <!-- LIST VIEW -->
  <div id="eventListView">
    <% if (!events || events.length === 0) { %>
      
      <div class="flex flex-col items-center justify-start pt-20 min-h-screen gap-6">
        <h2 class="p-3 text-6xl font-extrabold bg-gradientkleurBR bg-clip-text text-transparent">Maak je eerste evenement aan</h2>

        <button class="px-8 py-3 text-lg font-semibold rounded-full text-pink-500 border-2 border-pink-500 hover:bg-pink-500 hover:text-white transition-colors duration-300" 
                onclick="document.getElementById('EventAanmaakTab').classList.remove('hidden')">
          Start hier!
        </button>
      </div>

    <% } else { %>

      <!-- Header + knop -->
      <div class="flex justify-between mb-6">
        <h2 class="text-3xl font-bold bg-gradientkleurBR bg-clip-text text-transparent">Evenementen:</h2>
        <button 
          class="bg-purple-500 text-white px-4 py-2 rounded-lg hover:bg-purple-600"
          onclick="document.getElementById('EventAanmaakTab').classList.remove('hidden')">
          Nieuw Evenement
        </button>
      </div>

      <div class="space-y-6">

        <% events.forEach(event => { %>

          <div 
            class="border rounded-2xl p-6 shadow-sm hover:bg-gray-50 cursor-pointer transition"
            onclick="openEventDetail('<%= event.id %>')">

            <div class="flex justify-between items-center">
              <div>
                <h2 class="text-2xl font-semibold"><%= event.name %></h2>
                <p class="text-gray-500"><%= event.location %></p>
              </div>

              <% if(event.isLive) { %>
                <div class="p-3 text-right rounded-full bg-green-600 text-white inline-block">Live</div>
              <% } else { %>
                <div class="p-3 text-right rounded-full bg-red-500 text-white inline-block">Niet Live</div>
              <% } %>

            </div>

          </div>

        <% }) %>

      </div>
    <% } %>
  </div>




  <!-- DETAIL VIEW (1 EVENT) -->
  <div id="eventDetailView" class="hidden mt-10">

    <button onclick="closeEventDetail()" 
            class="mb-6 px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400">
      ← Terug
    </button>

    <div id="eventDetailContent"></div>
  </div>

</div>


<script>
  const events = <%- JSON.stringify(events || []) %>;

  function openEventDetail(id) {
    console.log("openEventDetail called with id:", id);
    const event = events.find(e => String(e.id) === String(id));
    console.log("found event:", event);
    if (!event) return alert("Event niet gevonden (check console)");

    document.getElementById("eventListView").classList.add("hidden");
    document.getElementById("eventDetailView").classList.remove("hidden");

    // content bouwen (kort)
    let html = `
      <h1 class="text-4xl font-bold mb-2">${event.name}</h1>
      <p class="text-gray-500 mb-4">${event.location}</p>
      <p class="text-sm text-gray-400 mb-4">
        ${new Date(event.startDate).toLocaleString("nl-BE")} → ${new Date(event.endDate).toLocaleString("nl-BE")}
      </p>
      ${event.description ? `<p class="mb-10">${event.description}</p>` : ""}
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xl font-semibold">Locaties & Items</h3>
        <button class="bg-blue-600 text-white px-3 py-1 rounded-lg hover:bg-blue-700"
                onclick="openAddLocationModel('${event.id}')">Locatie Toevoegen</button>
      </div>
    `;

    if (!event.stations || event.stations.length === 0) {
      html += `<p class="text-gray-500 text-sm mb-6">Nog geen locaties toegevoegd</p>`;
    } else {
      html += `<div class="grid gap-4">`;
      event.stations.forEach(st => {
        html += `
          <div class="border rounded-xl p-4">
            <div class="flex justify-between items-center mb-2">
              <h4 class="font-semibold">${st.name}</h4>
              <button class="bg-gray-200 px-2 py-1 rounded-lg text-sm hover:bg-gray-300"
                      onclick="openAddItemModel('${st.id}')">+ Item</button>
            </div>
        `;
        if (!st.items || st.items.length === 0) {
          html += `<p class="text-gray-500 text-sm">Nog geen items</p>`;
        } else {
          html += `<div class="grid gap-2">`;
          st.items.forEach(it => {
            html += `
              <div class="flex justify-between items-center p-3 bg-gray-100 rounded-lg">
                <div>
                  <p class="font-medium">${it.name}</p>
                  <p class="text-sm text-gray-500">Voorraad: ${it.stock}</p>
                </div>
                <p class="font-semibold text-lg">${it.price} FestCoins</p>
              </div>
            `;
          });
          html += `</div>`;
        }
        html += `</div>`;
      });
      html += `</div>`;
    }

    html += `<button class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 mt-10">Evenement verwijderen</button>`;

    document.getElementById("eventDetailContent").innerHTML = html;
  }

  function closeEventDetail() {
    document.getElementById("eventDetailView").classList.add("hidden");
    document.getElementById("eventListView").classList.remove("hidden");
  }
</script>


<script type="module" src="/js/eventBeheer.js"></script>
